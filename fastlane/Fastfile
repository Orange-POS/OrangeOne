default_platform(:ios)
ROOT = File.expand_path('..', __dir__)

# No Apple ID password/session is used; the key stays in runner temp storage.
def connect_key
  app_store_connect_api_key(
    key_id: ENV.fetch('APP_STORE_CONNECT_KEY_ID'),
    issuer_id: ENV.fetch('APP_STORE_CONNECT_ISSUER_ID'),
    key_filepath: ENV.fetch('APP_STORE_CONNECT_KEY_FILE'),
    duration: 1200,
    in_house: false
  )
end

def require_main
  UI.user_error!('Distribution is manual from main only') unless
    ENV['GITHUB_REF'] == 'refs/heads/main' && ENV['GITHUB_EVENT_NAME'] == 'workflow_dispatch'
end

platform :ios do
  desc 'Sign production and upload to internal TestFlight (no public release)'
  lane :beta do
    require_main
    key = connect_key
    bundle_id = 'com.orangeone.app'
    # Export on a fresh trusted runner; never rebuild PR code with Apple keys.
    sh('python3', File.join(ROOT, 'tool/ci/export_ipa.py'))
    candidates = Dir[File.join(ROOT, 'build/ios/ipa/*.ipa')]
    UI.user_error!('Expected one exported IPA') unless candidates.length == 1
    ipa = candidates.first
    upload_to_testflight(
      api_key: key,
      app_identifier: bundle_id,
      ipa: ipa,
      changelog: "Production #{ENV['PR_NUMBER'].to_s.empty? ? 'main' : 'PR #' + ENV['PR_NUMBER']} @ #{ENV['SOURCE_SHA']}",
      distribute_external: false,
      skip_waiting_for_build_processing: false
    )
  end

  desc 'Submit an existing iPhone-tested TestFlight build; release remains manual'
  lane :submit do
    require_main
    UI.user_error!('Confirm physical iPhone smoke testing first') unless
      ENV['IPHONE_SMOKE_TEST_CONFIRMED'] == 'true'
    upload_to_app_store(
      api_key: connect_key,
      app_identifier: 'com.orangeone.app',
      app_version: ENV.fetch('RELEASE_VERSION'),
      build_number: ENV.fetch('RELEASE_BUILD_NUMBER'),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end
end
