require_relative '../tool/ci/testflight_groups'
require_relative '../tool/ci/testflight_build_number'
default_platform(:ios)
ROOT = File.expand_path('..', __dir__)

# No Apple ID password/session is used; the key stays in runner temp storage.
def connect_key
  app_store_connect_api_key(
    key_id: ENV.fetch('APP_STORE_CONNECT_KEY_ID'),
    issuer_id: ENV.fetch('APP_STORE_CONNECT_ISSUER_ID'),
    key_filepath: ENV.fetch('APP_STORE_CONNECT_KEY_FILE'),
    duration: 1200,
    in_house: false
  )
end

def require_main
  UI.user_error!('Distribution is manual from main only') unless
    ENV['GITHUB_REF'] == 'refs/heads/main' && ENV['GITHUB_EVENT_NAME'] == 'workflow_dispatch'
end

# DEV/STG delivery: branch -> [flavor, tester group]. Production is not listed.
CHANNELS = {
  'refs/heads/develop' => %w[development dev],
  'refs/heads/staging' => %w[staging staging]
}.freeze

def channel_group
  flavor, group = CHANNELS.fetch(ENV['GITHUB_REF'].to_s) do
    UI.user_error!('TestFlight delivery is limited to the develop and staging branches')
  end
  UI.user_error!('TestFlight delivery runs only for a push or a manual dispatch') unless
    %w[push workflow_dispatch].include?(ENV['GITHUB_EVENT_NAME'])
  UI.user_error!('The flavor does not match the branch') unless ENV['CHANNEL_FLAVOR'] == flavor
  UI.user_error!('The tester group does not match the branch') unless ENV['TARGET_GROUP'] == group
  UI.user_error!('Signing always uses the production identity') unless
    ENV.fetch('RELEASE_FLAVOR', 'production') == 'production'
  group
end

platform :ios do
  desc 'Allocate the next build number from App Store Connect (read-only) for a DEV/STG push'
  lane :allocate_build do
    target = channel_group
    connect_key
    OrangeoneTestflight.new.prepare_channel(target)
    number = OrangeoneBuildNumber.new.allocate(floor: Integer(ENV.fetch('BUILD_NUMBER_FLOOR')))
    output = ENV.fetch('GITHUB_OUTPUT', '')
    File.write(output, "build_number=#{number}
", mode: 'a') unless output.empty?
    UI.success("Allocated build number #{number}.")
    number
  rescue OrangeoneTestflight::Error, OrangeoneBuildNumber::Error => error
    UI.user_error!(error.message)
  end

  desc 'Sign the DEV/STG archive and, unless dry run, upload it to its one tester group'
  lane :testflight_channel do
    target = channel_group
    dry_run = ENV.fetch('DRY_RUN', 'true') != 'false'
    UI.user_error!('Real uploads stay disabled until TESTFLIGHT_CD_ENABLED is true') unless
      dry_run || ENV['TESTFLIGHT_CD_ENABLED'] == 'true'
    version = ENV.fetch('RELEASE_VERSION')
    number = ENV.fetch('RELEASE_BUILD_NUMBER')
    key = connect_key
    distribution = OrangeoneTestflight.new.prepare_channel(target)
    OrangeoneBuildNumber.new.assert_unused(number: number, floor: Integer(ENV.fetch('BUILD_NUMBER_FLOOR')))
    sh('python3', File.join(ROOT, 'tool/ci/export_ipa.py'))
    candidates = Dir[File.join(ROOT, 'build/ios/ipa', '*.ipa')]
    UI.user_error!("Expected one exported IPA; found #{candidates.length} candidate(s)") unless candidates.length == 1
    if dry_run
      UI.success('Dry run: the signed export was verified; nothing was uploaded or assigned.')
    else
      upload_to_testflight(
        api_key: key,
        app_identifier: OrangeoneTestflight::BUNDLE_ID,
        ipa: candidates.first,
        app_version: version,
        build_number: number,
        skip_submission: true,
        distribute_external: false,
        submit_beta_review: false,
        notify_external_testers: false,
        skip_waiting_for_build_processing: true
      )
      distribution.distribute(version: version, number: number)
      UI.success('The exact build was assigned to its channel tester group only.')
    end
  rescue OrangeoneTestflight::Error, OrangeoneBuildNumber::Error => error
    UI.user_error!(error.message)
  end

  desc 'Upload production and assign the exact build to one approved TestFlight group'
  lane :beta do
    require_main
    UI.user_error!('Signed releases must use production') unless
      ENV.fetch('RELEASE_FLAVOR', 'production') == 'production'
    target = ENV.fetch('TARGET_GROUP', 'production')
    OrangeoneTestflight.group_name(target) # Reject arbitrary names/IDs before loading keys.
    key = connect_key
    distribution = OrangeoneTestflight.new.prepare(target)
    # Export on a fresh trusted runner; never rebuild PR code with Apple keys.
    sh('python3', File.join(ROOT, 'tool/ci/export_ipa.py'))
    ipa_directory = File.join(ROOT, 'build/ios/ipa')
    candidates = Dir[File.join(ipa_directory, '*.ipa')]
    UI.user_error!("Expected one exported IPA; found #{candidates.length} candidate(s) in #{ipa_directory}") unless candidates.length == 1
    ipa = candidates.first
    upload_to_testflight(
      api_key: key,
      app_identifier: OrangeoneTestflight::BUNDLE_ID,
      ipa: ipa,
      app_version: ENV.fetch('RELEASE_VERSION'),
      build_number: ENV.fetch('RELEASE_BUILD_NUMBER'),
      skip_submission: true,
      distribute_external: false,
      submit_beta_review: false,
      notify_external_testers: false,
      skip_waiting_for_build_processing: true
    )
    distribution.distribute(version: ENV.fetch('RELEASE_VERSION'), number: ENV.fetch('RELEASE_BUILD_NUMBER'))
    UI.success('Exact production build assignment confirmed for the selected TestFlight group.')
  rescue OrangeoneTestflight::Error => error
    UI.user_error!(error.message)
  end

  desc 'Assign an existing exact production build without export, signing or upload'
  lane :distribute_existing do
    require_main
    UI.user_error!('Distribution must use production') unless
      ENV.fetch('RELEASE_FLAVOR', 'production') == 'production'
    UI.user_error!('Existing-build distribution does not accept PR selection') unless
      ENV.fetch('PR_NUMBER', '').strip.empty?
    target = ENV.fetch('TARGET_GROUP', 'production')
    OrangeoneTestflight.group_name(target)
    connect_key
    OrangeoneTestflight.new.prepare(target).distribute(
      version: ENV.fetch('RELEASE_VERSION'), number: ENV.fetch('RELEASE_BUILD_NUMBER')
    )
    UI.success('Exact production build assignment confirmed for the selected TestFlight group.')
  rescue OrangeoneTestflight::Error => error
    UI.user_error!(error.message)
  end

  desc 'Submit an existing iPhone-tested TestFlight build; release remains manual'
  lane :submit do
    require_main
    UI.user_error!('App Store submission is production-only') unless
      ENV.fetch('RELEASE_FLAVOR', 'production') == 'production'
    UI.user_error!('Confirm physical iPhone smoke testing first') unless
      ENV['IPHONE_SMOKE_TEST_CONFIRMED'] == 'true'
    upload_to_app_store(
      api_key: connect_key,
      app_identifier: OrangeoneTestflight::BUNDLE_ID,
      app_version: ENV.fetch('RELEASE_VERSION'),
      build_number: ENV.fetch('RELEASE_BUILD_NUMBER'),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end
end
