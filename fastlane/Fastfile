require 'base64'
require 'cfpropertylist'
require 'fileutils'
require 'open3'
require 'securerandom'
require 'tmpdir'

default_platform(:ios)
ROOT = File.expand_path('..', __dir__)

# Credential-bearing subprocesses must never print their arguments or output.
def signing_command(*args)
  output, status = Open3.capture2e(*args)
  UI.user_error!('Apple signing failed. Check certificate, profile and team.') unless status.success?
  output
end

platform :ios do
  desc 'Build production main and upload to TestFlight; never submit for review'
  lane :beta do
    UI.user_error!('Signing is restricted to main.') unless ENV['GITHUB_REF'] == 'refs/heads/main'
    names = %w[APPLE_TEAM_ID IOS_CERTIFICATE_BASE64 IOS_CERTIFICATE_PASSWORD
               IOS_PROVISION_PROFILE_BASE64 APP_STORE_CONNECT_KEY_BASE64
               APP_STORE_CONNECT_KEY_ID APP_STORE_CONNECT_ISSUER_ID]
    names.each { |name| UI.user_error!("Missing secret: #{name}") if ENV[name].to_s.empty? }

    Dir.mktmpdir('orangeone-signing-', ENV.fetch('RUNNER_TEMP')) do |temporary|
      keychain = File.join(temporary, 'signing.keychain-db')
      previous = signing_command('/usr/bin/security', 'list-keychains', '-d', 'user').scan(/"([^"]+)"/).flatten
      installed_profile = nil
      begin
        files = {'IOS_CERTIFICATE_BASE64' => 'distribution.p12',
                 'IOS_PROVISION_PROFILE_BASE64' => 'profile.mobileprovision',
                 'APP_STORE_CONNECT_KEY_BASE64' => 'AuthKey.p8'}
        files.each do |secret, filename|
          File.write(File.join(temporary, filename), Base64.strict_decode64(ENV.fetch(secret).gsub(/\s/, '')), perm: 0600)
        end
        profile_file = File.join(temporary, 'profile.mobileprovision')
        xml = signing_command('/usr/bin/security', 'cms', '-D', '-i', profile_file)
        profile = CFPropertyList.native_types(CFPropertyList::List.new(data: xml).value)
        team = ENV.fetch('APPLE_TEAM_ID')
        prefix = profile.fetch('ApplicationIdentifierPrefix').first
        unless profile.fetch('TeamIdentifier').include?(team) &&
               profile.fetch('Entitlements')['application-identifier'] == "#{prefix}.com.orangeone.app" &&
               profile.fetch('Entitlements')['get-task-allow'] == false &&
               !profile.key?('ProvisionedDevices') && !profile['ProvisionsAllDevices'] &&
               profile.fetch('ExpirationDate') > Time.now &&
               /\A[A-Fa-f0-9-]{36}\z/.match?(profile.fetch('UUID'))
          UI.user_error!('Use an unexpired App Store distribution profile for com.orangeone.app.')
        end
        directory = File.expand_path('~/Library/MobileDevice/Provisioning Profiles')
        FileUtils.mkdir_p(directory)
        installed_profile = File.join(directory, profile.fetch('UUID') + '.mobileprovision')
        FileUtils.cp(profile_file, installed_profile)
        password = SecureRandom.hex(32)
        signing_command('/usr/bin/security', 'create-keychain', '-p', password, keychain)
        signing_command('/usr/bin/security', 'set-keychain-settings', '-lut', '21600', keychain)
        signing_command('/usr/bin/security', 'unlock-keychain', '-p', password, keychain)
        signing_command('/usr/bin/security', 'import', File.join(temporary, 'distribution.p12'),
                        '-P', ENV.fetch('IOS_CERTIFICATE_PASSWORD'), '-T', '/usr/bin/codesign', '-T', '/usr/bin/security', '-k', keychain)
        signing_command('/usr/bin/security', 'set-key-partition-list', '-S', 'apple-tool:,apple:,codesign:', '-k', password, keychain)
        signing_command('/usr/bin/security', 'list-keychains', '-d', 'user', '-s', keychain, *previous)

        key = app_store_connect_api_key(
          key_id: ENV.fetch('APP_STORE_CONNECT_KEY_ID'), issuer_id: ENV.fetch('APP_STORE_CONNECT_ISSUER_ID'),
          key_filepath: File.join(temporary, 'AuthKey.p8'), duration: 1200, in_house: false
        )
        version = File.read(File.join(ROOT, 'pubspec.yaml'))[/^version: (\d+\.\d+\.\d+)/, 1]
        UI.user_error!('Set a three-part version in pubspec.yaml.') unless version
        latest = latest_testflight_build_number(api_key: key, app_identifier: 'com.orangeone.app',
                                               version: version, initial_build_number: 0).to_s
        UI.user_error!('Previous build must be an integer; coordinate numbering in App Store Connect.') unless /\A\d+\z/.match?(latest)
        build = (latest.to_i + 1).to_s
        UI.user_error!('Increment the marketing version before build 10000.') if build.to_i > 9999
        Dir.chdir(ROOT) do
          sh('flutter', 'build', 'ios', '--config-only', '--release', '--flavor', 'production',
             '--target', 'lib/main_production.dart', '--dart-define-from-file=config/production.example.json', '--build-number', build)
        end
        update_code_signing_settings(
          use_automatic_signing: false, path: File.join(ROOT, 'ios/Runner.xcodeproj'),
          targets: ['Runner'], build_configurations: ['Release-production'],
          team_id: team, code_sign_identity: 'Apple Distribution',
          profile_name: profile.fetch('Name'), bundle_identifier: 'com.orangeone.app'
        )
        sh('pod', 'install', '--project-directory=' + File.join(ROOT, 'ios'))
        build_app(
          workspace: File.join(ROOT, 'ios/Runner.xcworkspace'), scheme: 'production',
          configuration: 'Release-production', export_method: 'app-store-connect',
          output_directory: File.join(ROOT, 'build/ios/ipa'), output_name: 'OrangeONE.ipa',
          export_options: {method: 'app-store-connect', signingStyle: 'manual', teamID: team,
                           provisioningProfiles: {'com.orangeone.app' => profile.fetch('Name')}}
        )
        upload_to_testflight(api_key: key, app_identifier: 'com.orangeone.app',
                             ipa: File.join(ROOT, 'build/ios/ipa/OrangeONE.ipa'),
                             changelog: "Production main #{ENV['SOURCE_SHA'] || ENV['GITHUB_SHA']}",
                             distribute_external: false, skip_waiting_for_build_processing: false)
      ensure
        begin
          signing_command('/usr/bin/security', 'list-keychains', '-d', 'user', '-s', *previous)
        ensure
          begin
            FileUtils.rm_f(installed_profile) if installed_profile
          ensure
            signing_command('/usr/bin/security', 'delete-keychain', keychain) if File.exist?(keychain)
          end
        end
      end
    end
  end
end
